table period_retention
	lineageTag: 8420a2c2-6a16-5d42-bfb6-1e72fc4a0bd5

	/// Share of the households active in a 4-week period that are active again in the next one.
	measure 'Retention Rate' = DIVIDE ( SUM ( period_retention[retained_next_period] ), SUM ( period_retention[active_households] ) )
		formatString: 0.0%
		lineageTag: 68c21303-d8ae-533b-b1e8-ad67912ad1ad

	column period
		dataType: int64
		formatString: 0
		lineageTag: 7e92afcb-1d7d-548f-8827-1a8dec24d958
		summarizeBy: none
		sourceColumn: period

	column active_households
		dataType: int64
		formatString: #,0
		lineageTag: 79a6fc7c-6bfa-5ab2-8f8c-f88273eb2b19
		summarizeBy: none
		sourceColumn: active_households

	column retained_next_period
		dataType: int64
		formatString: #,0
		lineageTag: 8bd6b575-d736-5dc7-baae-0b9fbbfd07c2
		summarizeBy: none
		sourceColumn: retained_next_period

	column retention_rate
		dataType: double
		formatString: 0.0%
		lineageTag: dad7fed3-0786-5ef8-98ff-6fd993d5dab2
		summarizeBy: none
		sourceColumn: retention_rate

	partition period_retention = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dashboard\period_retention.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // en-US: the CSV files use a dot as the decimal separator, whatever the Windows language
				    Typed = Table.TransformColumnTypes(Headers, {{"period", Int64.Type}, {"active_households", Int64.Type}, {"retained_next_period", Int64.Type}, {"retention_rate", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

