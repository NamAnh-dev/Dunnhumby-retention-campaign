table weekly_kpis
	lineageTag: ac82341d-d015-51f6-a2b9-75f2d28ddcb5

	/// Sales after returns.
	measure 'Net Sales' = SUM ( weekly_kpis[net_sales] )
		formatString: #,0
		lineageTag: c04c65bc-2b85-5d8f-bf65-5cba3f3faab6

	/// Median number of households with net sales > 0 per week.
	measure 'Active Households' = MEDIAN ( weekly_kpis[active_households] )
		formatString: #,0
		lineageTag: b8594529-7aa1-59e6-8a8f-98e5ae32759c

	/// Net sales / number of baskets.
	measure 'Basket Value' = DIVIDE ( SUM ( weekly_kpis[net_sales] ), SUM ( weekly_kpis[baskets] ) )
		formatString: 0.00
		lineageTag: 5a05f983-0a91-572c-b576-bee5a8646825

	column week_no
		dataType: int64
		formatString: 0
		lineageTag: 7540a977-a87a-59ce-b491-8161afabfc47
		summarizeBy: none
		sourceColumn: week_no

	column active_households
		dataType: int64
		formatString: #,0
		lineageTag: 7087cf06-4cf0-583f-9373-d5faf3a92cb2
		summarizeBy: none
		sourceColumn: active_households

	column baskets
		dataType: int64
		formatString: #,0
		lineageTag: 521f9c0a-66f9-57f9-b997-e66ab85a1897
		summarizeBy: none
		sourceColumn: baskets

	column net_sales
		dataType: double
		formatString: #,0
		lineageTag: a7bd5c15-efbe-5f4d-b053-7c93519ada06
		summarizeBy: none
		sourceColumn: net_sales

	column avg_basket_value
		dataType: double
		formatString: 0.00
		lineageTag: 3c1869fd-fa02-5d12-a750-e0a289ba5e73
		summarizeBy: none
		sourceColumn: avg_basket_value

	column discount_share
		dataType: double
		formatString: 0.0%
		lineageTag: a27ab85b-24b2-54fc-a19c-353811e0632c
		summarizeBy: none
		sourceColumn: discount_share

	partition weekly_kpis = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dashboard\weekly_kpis.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // en-US: the CSV files use a dot as the decimal separator, whatever the Windows language
				    Typed = Table.TransformColumnTypes(Headers, {{"week_no", Int64.Type}, {"active_households", Int64.Type}, {"baskets", Int64.Type}, {"net_sales", type number}, {"avg_basket_value", type number}, {"discount_share", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

