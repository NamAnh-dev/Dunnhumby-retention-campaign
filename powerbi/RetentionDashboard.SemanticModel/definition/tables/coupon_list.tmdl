table coupon_list
	lineageTag: 1a64883e-21dd-5834-9dec-6c79b705f48a

	measure 'Households on List' = COUNTROWS ( coupon_list )
		formatString: #,0
		lineageTag: 0c930b19-c752-5138-b359-662b35022d7e

	/// Churn probability x sales in the last 12 weeks, summed over the coupon list.
	measure 'Expected Sales Lost' = SUM ( coupon_list[expected_sales_lost] )
		formatString: #,0
		lineageTag: 8f3e9445-53dd-54c1-b54a-cf0e885f8769

	measure 'Average Churn Probability' = AVERAGE ( coupon_list[churn_probability] )
		formatString: 0.0%
		lineageTag: 951feb93-0948-5105-96f5-93d787c9e2ad

	column household_key
		dataType: int64
		formatString: 0
		lineageTag: c622f87f-d068-5dea-952d-4b2ec43f0e64
		summarizeBy: none
		sourceColumn: household_key

	column churn_probability
		dataType: double
		formatString: 0.0%
		lineageTag: b08873ed-7c8f-53ab-b58a-040c46d581c9
		summarizeBy: none
		sourceColumn: churn_probability

	column sales_12w
		dataType: double
		formatString: #,0
		lineageTag: 12ee93f8-a701-5747-88f9-ba789437c04e
		summarizeBy: none
		sourceColumn: sales_12w

	column expected_sales_lost
		dataType: double
		formatString: #,0.0
		lineageTag: 8a6e9b55-aa83-58e1-a52e-6b5ad8d82391
		summarizeBy: none
		sourceColumn: expected_sales_lost

	column recency_weeks
		dataType: int64
		formatString: 0
		lineageTag: 1b081260-e2f0-5563-99df-bad8365f322b
		summarizeBy: none
		sourceColumn: recency_weeks

	column active_weeks_12w
		dataType: double
		formatString: 0
		lineageTag: 89e573b0-e79b-52d1-acf1-7569144d8f10
		summarizeBy: none
		sourceColumn: active_weeks_12w

	partition coupon_list = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "coupon_list.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // en-US: the CSV files use a dot as the decimal separator, whatever the Windows language
				    Typed = Table.TransformColumnTypes(Headers, {{"household_key", Int64.Type}, {"churn_probability", type number}, {"sales_12w", type number}, {"expected_sales_lost", type number}, {"recency_weeks", Int64.Type}, {"active_weeks_12w", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

