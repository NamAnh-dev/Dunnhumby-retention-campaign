{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "cu_share_bar",
  "position": {
    "x": 24,
    "y": 96,
    "z": 1,
    "height": 520,
    "width": 620,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "segments"
                    }
                  },
                  "Property": "segment"
                }
              },
              "queryRef": "segments.segment",
              "nativeQueryRef": "segment",
              "active": true,
              "displayName": "Segment"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "segments"
                    }
                  },
                  "Property": "Segment Share of Households"
                }
              },
              "queryRef": "segments.Segment Share of Households",
              "nativeQueryRef": "Segment Share of Households",
              "displayName": "Share of households"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "segments"
                    }
                  },
                  "Property": "Segment Share of Sales"
                }
              },
              "queryRef": "segments.Segment Share of Sales",
              "nativeQueryRef": "Segment Share of Sales",
              "displayName": "Share of sales"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "segments"
                  }
                },
                "Property": "Segment Share of Sales"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Share of households vs share of sales'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
